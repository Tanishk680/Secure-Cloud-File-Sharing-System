# Lambda environment variables (set these in the SAM template / AWS console)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-private-files-bucket
DYNAMODB_FILES_TABLE=FilesTable
DYNAMODB_SHARES_TABLE=SharesTable
FILES_OWNER_INDEX=ownerId-index
SHARES_FILE_INDEX=fileId-index
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
